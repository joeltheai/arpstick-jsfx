+static EEL_F NSEEL_CGEN_CALL _jsfx_midisend(void *o, INT_PTR np, EEL_F **p) { if (_midi_log_n<4096){ _midi_log[_midi_log_n][0]=(np>0?*p[0]:0); _midi_log[_midi_log_n][1]=(np>1?*p[1]:0); _midi_log[_midi_log_n][2]=(np>2?*p[2]:0); _midi_log[_midi_log_n][3]=(np>3?*p[3]:0); _midi_log_n++; } return 0.0; }
