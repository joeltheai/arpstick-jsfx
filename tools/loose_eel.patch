+static EEL_F NSEEL_CGEN_CALL _jsfx_push(void *o, INT_PTR np, EEL_F **p) { if (_midi_in_n<4096){ _midi_in[_midi_in_n][0]=*p[0]; _midi_in[_midi_in_n][1]=*p[1]; _midi_in[_midi_in_n][2]=*p[2]; _midi_in[_midi_in_n][3]=*p[3]; _midi_in_n++; } return 0.0; }
+static EEL_F NSEEL_CGEN_CALL _jsfx_dump(void *o, INT_PTR np, EEL_F **p) { int i; for(i=0;i<_midi_log_n;i++) printf("MIDI %d: st=%d d1=%d d2=%d offs=%.1f\n", i, (int)_midi_log[i][1], (int)_midi_log[i][2], (int)_midi_log[i][3], _midi_log[i][0]); _midi_log_n=0; return 0.0; }
