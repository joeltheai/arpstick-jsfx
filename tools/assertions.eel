function check(ok,label) (ok ? printf("PASS: %s\n",label) : printf("FAIL: %s\n",label););
function blockRun(count) local(q) (__block(); q=0; while(q<count) (__sample(); q+=1;););
srate=48000; tempo=120; samplesblock=64;
slider1=1; slider2=0; __slider();
push_midi(20,144,48,100); push_midi(45,128,48,0);
blockRun(64);
check(actCnt==0,"chord released within block"); dump_midi(); // on @20, off @45
slider1=0; slider2=1; retG[0]=1; __slider(); play_state=1; beat_position=0;
push_midi(30,144,60,91); blockRun(64);
check(arpCnt==1,"timestamped arp input"); dump_midi();
curGraph=0; __block(); savedL=L; curGraph=3; cdvG[3]=4; __block();
check(L==savedL,"tab selection cannot change tempo");
resG[0]=1; lnkG[0]=1; swingG[0]=40; patternCopy(0,1);
check(resG[16]==1 && lnkG[1]==1 && swingG[1]==40,"complete pattern copy");
pat=0; curGraph=0; graphCopy(); resG[0]=0; graphPaste();
check(resG[0]==1,"graph copy preserves reset arrows");
lrn=1; lrnMode=3; lrnCnt=0; lrnHeld=0; curSlot=55;
k=0; while(k<12) (inputNoteOn(48+k,100,0,0); k+=1;);
check(lrnCnt==8,"learn clamps to eight voices");
k=0; while(k<12) (inputNoteOff(48+k,0,0); k+=1;);
check(lrn==0 && curSlot==55,"single-slot learning stops without advancing");
pat=0; slider8=0; slider1=0; slider2=1; __slider(); panicRequest=1;
play_state=0; freeOn=1; synced=0; blockRun(64);
push_midi(12,144,64,100); blockRun(64);
check(arpCnt==1 && lastFired>=0,"free clock runs stopped"); dump_midi();
slider6=6; __slider(); blockRun(64);
push_midi(0,144,67,100); blockRun(64);
check(outChan==5,"output channel routing");
panicRequest=1; blockRun(64);
check(arpCnt==0 && sndCnt==0 && actCnt==0,"panic clears held and output voices"); dump_midi();
smpi=0; chOn=0; pat=0; notG[0]=0; lrn=0; arpCnt=1; helB[0]=60; lenN=16; lenR=16; lenO=16; lenP=16; lenV=16; lenG2=16; lenH=16;
velG[0]=0; now=0; arpFire(0);
check(sndCnt==0,"zero velocity is silent");
velG[0]=100; gatG[0]=100; resG[0]=0; arpFire(0);
check(sndCnt==1,"arp strike"); mutG[0]=1; arpFire(0);
check(sndCnt==0,"muted step releases tied notes");
mutG[0]=0; helB[0]=60; helB[1]=72; arpCnt=2; rebuildArp();
slider1=0; slider2=0; slider6=0; __slider(); freeOn=0; synced=1; play_state=0; blockRun(64);
push_midi(10,144,70,80); blockRun(64);
slider1=1; __slider(); blockRun(64);
check(outRefs[70]==0,"module change releases bypass notes"); dump_midi();
// Exercise every lane's drawing and the corrected mouse modifier masks.
gfx_w=1152; gfx_h=768; mouse_x=-1; mouse_y=-1;
k=0; while(k<8) (curGraph=k; __gfx(); k+=1;);
check(sc>0,"all GUI lanes execute");
gfx_w=2304; gfx_h=1536; __gfx();
check(abs(sc-2.4)<0.00001,"Retina framebuffer scales beyond 200 percent");
mouse_x=px(580); mouse_y=py(13); __gfx();
check(hitTest(mx,my)==2,"Retina pointer coordinates match tone control");
gfx_w=1600; gfx_h=640; __gfx();
check(abs(sc-1)<0.00001 && abs(ox-320)<0.00001,"wide windows center without stretching");
gfx_w=480; gfx_h=320; __gfx();
check(abs(sc-0.5)<0.00001 && abs(ox)<0.00001 && abs(oy)<0.00001,"small windows fit without cropping");
mouse_x=-1; mouse_y=-1;

// Directional shapes must stay inside the held chord, even over many cycles.
pat=0; arpPatternDefaults(0); chOn=0; arpCnt=3;
helB[0]=48; helB[1]=52; helB[2]=55;
lenN=16; lenR=16; lenO=16; lenP=16; lenV=16; lenG2=16; lenH=16;
shape=8;
while(shape<16) (
  silenceAll(); shapePos=0;
  col=0; while(col<16) (notG[col]=shape; col+=1;);
  stable=1; step=0;
  while(step<192) (
    now=step*0.25; arpFire(step);
    (lastOutNote!=48 && lastOutNote!=52 && lastOutNote!=55) ? stable=0;
    step+=1;
  );
  check(stable,sprintf(#,"shape %d stays in chord for 192 steps",shape));
  shape+=1;
);
// Explicit numbered-note wrapping and the octave lane still transpose.
silenceAll(); shapePos=0; notG[0]=3; arpFire(0);
check(lastOutNote==60,"numbered note 4 wraps triad up one octave");
notG[0]=8; octG[0]=1; shapePos=0; arpFire(0);
check(lastOutNote==60,"octave lane intentionally transposes up shape");
// Drive real incoming root notes through the chord module across long holds.
silenceAll(); slider1=1; slider2=1; slider6=0; slider8=0; __slider();
freeOn=0; play_state=1; prevPlay=0; prevChord=0;
arpPatternDefaults(0); applyChordPreset(0);
col=0; while(col<16) (notG[col]=8; col+=1;);
rootIndex=0; progressionOK=1;
while(rootIndex<4) (
  progressionRoot=rootIndex==0 ? 48 : rootIndex==1 ? 53 : rootIndex==2 ? 55 : 45;
  // expected chord notes from the C major diatonic bank (preset 0)
  rootIndex==0 ? (a1=48; a2=52; a3=55) :
  rootIndex==1 ? (a1=53; a2=57; a3=60) :
  rootIndex==2 ? (a1=55; a2=59; a3=62) :
  (a1=45; a2=48; a3=52);
  push_midi(0,144,progressionRoot,100);
  step=0;
  while(step<48) (
    beat_position=(rootIndex*48+step)*0.25; blockRun(1);
    (lastOutNote!=a1 && lastOutNote!=a2 && lastOutNote!=a3) ? progressionOK=0;
    step+=1;
  );
  push_midi(0,128,progressionRoot,0); blockRun(1);
  rootIndex+=1;
);
check(progressionOK,"root-note progression stays in each chord register");
silenceAll();
printf("ASSERTIONS COMPLETE\n");
